{
  "name": "current-nai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,yellow \"vite\" \"uvicorn backend.main:app --reload --port 4000\"",
